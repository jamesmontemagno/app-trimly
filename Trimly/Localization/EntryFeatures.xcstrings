    "visibilityHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hidden measurements are excluded from this app's analytics. You can restore them in the timeline filters."}},"es":{"stringUnit":{"state":"translated","value":"Las mediciones ocultas se excluyen de los análisis de esta app. Puedes restaurarlas en los filtros del historial."}},"fr":{"stringUnit":{"state":"translated","value":"Les mesures masquées sont exclues des analyses de cette app. Vous pouvez les rétablir dans les filtres de l’historique."}}}},
