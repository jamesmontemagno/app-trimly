    "csv.error.size": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a CSV file smaller than 10 MB."}},"es":{"stringUnit":{"state":"translated","value":"Elige un archivo CSV de menos de 10 MB."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez un fichier CSV de moins de 10 Mo."}}}},
