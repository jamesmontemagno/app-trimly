    "dashboard.moveUp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Move up"}},"es":{"stringUnit":{"state":"translated","value":"Mover hacia arriba"}},"fr":{"stringUnit":{"state":"translated","value":"Déplacer vers le haut"}}}},
