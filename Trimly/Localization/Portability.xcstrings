{
  "sourceLanguage": "en",
  "strings": {
    "range.allTime": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"All time"}},"es":{"stringUnit":{"state":"translated","value":"Todo el historial"}},"fr":{"stringUnit":{"state":"translated","value":"Tout l’historique"}}}},
    "range.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Date range"}},"es":{"stringUnit":{"state":"translated","value":"Intervalo de fechas"}},"fr":{"stringUnit":{"state":"translated","value":"Période"}}}},
    "range.start": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start date"}},"es":{"stringUnit":{"state":"translated","value":"Fecha de inicio"}},"fr":{"stringUnit":{"state":"translated","value":"Date de début"}}}},
    "range.end": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"End date"}},"es":{"stringUnit":{"state":"translated","value":"Fecha de fin"}},"fr":{"stringUnit":{"state":"translated","value":"Date de fin"}}}},
    "range.hint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Includes the entire start and end dates in your current time zone."}},"es":{"stringUnit":{"state":"translated","value":"Incluye los días completos de inicio y fin en tu zona horaria actual."}},"fr":{"stringUnit":{"state":"translated","value":"Inclut les journées de début et de fin complètes dans votre fuseau horaire actuel."}}}},
    "range.invalid": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The end date must be on or after the start date."}},"es":{"stringUnit":{"state":"translated","value":"La fecha de fin debe ser igual o posterior a la de inicio."}},"fr":{"stringUnit":{"state":"translated","value":"La date de fin doit être égale ou postérieure à la date de début."}}}},
    "export.notes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Include notes"}},"es":{"stringUnit":{"state":"translated","value":"Incluir notas"}},"fr":{"stringUnit":{"state":"translated","value":"Inclure les notes"}}}},
    "export.hidden": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Include hidden entries"}},"es":{"stringUnit":{"state":"translated","value":"Incluir registros ocultos"}},"fr":{"stringUnit":{"state":"translated","value":"Inclure les entrées masquées"}}}},
    "export.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"CSV files contain weight values even when privacy mode is on. Notes and hidden entries are excluded unless selected. Share only with people you trust."}},"es":{"stringUnit":{"state":"translated","value":"Los archivos CSV contienen los pesos incluso con el modo de privacidad activado. Las notas y los registros ocultos se excluyen salvo que los selecciones. Comparte solo con personas de confianza."}},"fr":{"stringUnit":{"state":"translated","value":"Les fichiers CSV contiennent les poids même si le mode confidentialité est activé. Les notes et les entrées masquées sont exclues sauf si vous les sélectionnez. Partagez uniquement avec des personnes de confiance."}}}},
    "export.create": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare CSV"}},"es":{"stringUnit":{"state":"translated","value":"Preparar CSV"}},"fr":{"stringUnit":{"state":"translated","value":"Préparer le CSV"}}}},
    "export.save": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save CSV file"}},"es":{"stringUnit":{"state":"translated","value":"Guardar archivo CSV"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrer le fichier CSV"}}}},
    "export.filename": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"My-Weight-weights.csv"}},"es":{"stringUnit":{"state":"translated","value":"My-Weight-weights.csv"}},"fr":{"stringUnit":{"state":"translated","value":"My-Weight-weights.csv"}}}},
    "file.share": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share saved file"}},"es":{"stringUnit":{"state":"translated","value":"Compartir archivo guardado"}},"fr":{"stringUnit":{"state":"translated","value":"Partager le fichier enregistré"}}}},
    "export.excerpt": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preview shows the first 8 KB. The saved file includes every selected entry."}},"es":{"stringUnit":{"state":"translated","value":"La vista previa muestra los primeros 8 KB. El archivo guardado incluye todos los registros seleccionados."}},"fr":{"stringUnit":{"state":"translated","value":"L’aperçu affiche les 8 premiers Ko. Le fichier enregistré inclut toutes les entrées sélectionnées."}}}},
    "import.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import CSV"}},"es":{"stringUnit":{"state":"translated","value":"Importar CSV"}},"fr":{"stringUnit":{"state":"translated","value":"Importer un CSV"}}}},
    "import.subtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Map columns and review every measurement before importing"}},"es":{"stringUnit":{"state":"translated","value":"Asigna columnas y revisa cada medición antes de importar"}},"fr":{"stringUnit":{"state":"translated","value":"Associez les colonnes et vérifiez chaque mesure avant l’importation"}}}},
    "import.choose": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose CSV file"}},"es":{"stringUnit":{"state":"translated","value":"Elegir archivo CSV"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir un fichier CSV"}}}},
    "import.explanation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import UTF-8, comma-separated files up to 10 MB. This adds manual measurements, not a backup restore. HealthKit identity, hidden status, goals and settings are never restored from CSV."}},"es":{"stringUnit":{"state":"translated","value":"Importa archivos UTF-8 separados por comas de hasta 10 MB. Se añaden mediciones manuales; no se restaura una copia de seguridad. Los datos de identidad de HealthKit, el estado oculto, los objetivos y los ajustes nunca se restauran desde CSV."}},"fr":{"stringUnit":{"state":"translated","value":"Importez des fichiers UTF-8 séparés par des virgules de 10 Mo maximum. Des mesures manuelles sont ajoutées ; il ne s’agit pas d’une restauration. L’identité HealthKit, l’état masqué, les objectifs et les réglages ne sont jamais restaurés depuis un CSV."}}}},
    "import.header": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"First row contains column names"}},"es":{"stringUnit":{"state":"translated","value":"La primera fila contiene nombres de columnas"}},"fr":{"stringUnit":{"state":"translated","value":"La première ligne contient les noms des colonnes"}}}},
    "import.dateColumn": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Date"}},"es":{"stringUnit":{"state":"translated","value":"Fecha"}},"fr":{"stringUnit":{"state":"translated","value":"Date"}}}},
    "import.weightColumn": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Weight"}},"es":{"stringUnit":{"state":"translated","value":"Peso"}},"fr":{"stringUnit":{"state":"translated","value":"Poids"}}}},
    "import.unitColumn": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unit column"}},"es":{"stringUnit":{"state":"translated","value":"Columna de unidad"}},"fr":{"stringUnit":{"state":"translated","value":"Colonne d’unité"}}}},
    "import.notesColumn": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notes column"}},"es":{"stringUnit":{"state":"translated","value":"Columna de notas"}},"fr":{"stringUnit":{"state":"translated","value":"Colonne de notes"}}}},
    "import.dateConvention": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Date convention"}},"es":{"stringUnit":{"state":"translated","value":"Formato de fecha"}},"fr":{"stringUnit":{"state":"translated","value":"Format de date"}}}},
    "import.review": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preview and review rows"}},"es":{"stringUnit":{"state":"translated","value":"Previsualizar y revisar filas"}},"fr":{"stringUnit":{"state":"translated","value":"Afficher et vérifier les lignes"}}}},
    "import.mapping": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Column mapping"}},"es":{"stringUnit":{"state":"translated","value":"Asignación de columnas"}},"fr":{"stringUnit":{"state":"translated","value":"Association des colonnes"}}}},
    "import.mappingHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose distinct date and weight columns. Units may be kg, lb or st. Without a unit column, the selected unit applies to every row. Dates without a time zone use your current time zone. Slash dates require two-digit days and months; optional time is 24-hour HH:mm or HH:mm:ss. Weight decimals use a period."}},"es":{"stringUnit":{"state":"translated","value":"Elige columnas diferentes para fecha y peso. Las unidades pueden ser kg, lb o st. Sin columna de unidad, se aplica la seleccionada a todas las filas. Las fechas sin zona horaria usan la actual. Las fechas con barras requieren días y meses de dos dígitos; la hora opcional usa HH:mm o HH:mm:ss en formato de 24 horas. Usa un punto decimal para el peso."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez des colonnes distinctes pour la date et le poids. Les unités sont kg, lb ou st. Sans colonne d’unité, l’unité choisie s’applique partout. Les dates sans fuseau horaire utilisent le fuseau actuel. Les dates avec barres obliques exigent deux chiffres pour le jour et le mois ; l’heure facultative est au format 24 heures HH:mm ou HH:mm:ss. Le séparateur décimal du poids est le point."}}}},
    "import.notMapped": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not mapped"}},"es":{"stringUnit":{"state":"translated","value":"Sin asignar"}},"fr":{"stringUnit":{"state":"translated","value":"Non associée"}}}},
    "import.commit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import reviewed measurements"}},"es":{"stringUnit":{"state":"translated","value":"Importar mediciones revisadas"}},"fr":{"stringUnit":{"state":"translated","value":"Importer les mesures vérifiées"}}}},
    "import.reviewHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Invalid rows are not imported. Correct them in the original file and choose the file again. Existing measurements are never overwritten."}},"es":{"stringUnit":{"state":"translated","value":"Las filas no válidas no se importan. Corrígelas en el archivo original y vuelve a elegirlo. Nunca se sobrescriben las mediciones existentes."}},"fr":{"stringUnit":{"state":"translated","value":"Les lignes non valides ne sont pas importées. Corrigez-les dans le fichier d’origine puis sélectionnez-le à nouveau. Les mesures existantes ne sont jamais remplacées."}}}},
    "import.duplicate": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Possible duplicate — skipped by default"}},"es":{"stringUnit":{"state":"translated","value":"Posible duplicado: se omite de forma predeterminada"}},"fr":{"stringUnit":{"state":"translated","value":"Doublon possible — ignoré par défaut"}}}},
    "import.keep": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep as a separate measurement"}},"es":{"stringUnit":{"state":"translated","value":"Conservar como medición independiente"}},"fr":{"stringUnit":{"state":"translated","value":"Conserver comme mesure distincte"}}}},
    "import.ready": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ready to import"}},"es":{"stringUnit":{"state":"translated","value":"Listo para importar"}},"fr":{"stringUnit":{"state":"translated","value":"Prêt à importer"}}}},
    "import.preview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Row preview"}},"es":{"stringUnit":{"state":"translated","value":"Vista previa de filas"}},"fr":{"stringUnit":{"state":"translated","value":"Aperçu des lignes"}}}},
    "import.duplicateExplanation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A possible duplicate is within one second and 0.001 kg of an existing measurement (including hidden entries) or an earlier CSV row. Enable Keep only for rows you want to add separately; nothing is merged."}},"es":{"stringUnit":{"state":"translated","value":"Un posible duplicado difiere en menos de un segundo y 0,001 kg de una medición existente (incluidas las ocultas) o de una fila anterior del CSV. Activa Conservar solo para las filas que quieras añadir por separado; no se fusiona nada."}},"fr":{"stringUnit":{"state":"translated","value":"Un doublon possible diffère de moins d’une seconde et de 0,001 kg d’une mesure existante (y compris masquée) ou d’une ligne CSV précédente. Activez Conserver uniquement pour les lignes à ajouter séparément ; rien n’est fusionné."}}}},
    "import.complete": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import complete"}},"es":{"stringUnit":{"state":"translated","value":"Importación completada"}},"fr":{"stringUnit":{"state":"translated","value":"Importation terminée"}}}},
    "report.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Progress report"}},"es":{"stringUnit":{"state":"translated","value":"Informe de progreso"}},"fr":{"stringUnit":{"state":"translated","value":"Rapport de progression"}}}},
    "report.subtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preview and share a PDF chart and summary"}},"es":{"stringUnit":{"state":"translated","value":"Previsualiza y comparte un gráfico y resumen en PDF"}},"fr":{"stringUnit":{"state":"translated","value":"Affichez et partagez un graphique et un résumé en PDF"}}}},
    "report.includeGoal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Include current goal"}},"es":{"stringUnit":{"state":"translated","value":"Incluir objetivo actual"}},"fr":{"stringUnit":{"state":"translated","value":"Inclure l’objectif actuel"}}}},
    "report.create": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prepare report"}},"es":{"stringUnit":{"state":"translated","value":"Preparar informe"}},"fr":{"stringUnit":{"state":"translated","value":"Préparer le rapport"}}}},
    "report.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reports include weight values even when privacy mode is on. Notes and hidden entries are always excluded. Preview your report before sharing."}},"es":{"stringUnit":{"state":"translated","value":"Los informes incluyen los pesos incluso con el modo de privacidad activado. Las notas y los registros ocultos siempre se excluyen. Revisa el informe antes de compartirlo."}},"fr":{"stringUnit":{"state":"translated","value":"Les rapports incluent les poids même si le mode confidentialité est activé. Les notes et les entrées masquées sont toujours exclues. Vérifiez votre rapport avant de le partager."}}}},
    "report.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No visible measurements in this date range."}},"es":{"stringUnit":{"state":"translated","value":"No hay mediciones visibles en este intervalo."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune mesure visible dans cette période."}}}},
    "report.save": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save PDF report"}},"es":{"stringUnit":{"state":"translated","value":"Guardar informe PDF"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrer le rapport PDF"}}}},
    "report.filename": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"My-Weight-progress.pdf"}},"es":{"stringUnit":{"state":"translated","value":"My-Weight-progress.pdf"}},"fr":{"stringUnit":{"state":"translated","value":"My-Weight-progress.pdf"}}}},
    "report.preview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preview saved PDF"}},"es":{"stringUnit":{"state":"translated","value":"Previsualizar PDF guardado"}},"fr":{"stringUnit":{"state":"translated","value":"Afficher le PDF enregistré"}}}},
    "report.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The PDF could not be created. Please try again."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo crear el PDF. Inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Le PDF n’a pas pu être créé. Veuillez réessayer."}}}},
    "report.goal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current goal (dashed line)"}},"es":{"stringUnit":{"state":"translated","value":"Objetivo actual (línea discontinua)"}},"fr":{"stringUnit":{"state":"translated","value":"Objectif actuel (ligne en pointillés)"}}}},
    "report.chart": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Daily weight progress chart"}},"es":{"stringUnit":{"state":"translated","value":"Gráfico de evolución del peso diario"}},"fr":{"stringUnit":{"state":"translated","value":"Graphique de progression du poids quotidien"}}}},
    "report.first": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"First daily weight"}},"es":{"stringUnit":{"state":"translated","value":"Primer peso diario"}},"fr":{"stringUnit":{"state":"translated","value":"Premier poids quotidien"}}}},
    "report.latest": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Latest daily weight"}},"es":{"stringUnit":{"state":"translated","value":"Último peso diario"}},"fr":{"stringUnit":{"state":"translated","value":"Dernier poids quotidien"}}}},
    "report.change": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Change"}},"es":{"stringUnit":{"state":"translated","value":"Cambio"}},"fr":{"stringUnit":{"state":"translated","value":"Variation"}}}},
    "report.average": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Average of daily weights"}},"es":{"stringUnit":{"state":"translated","value":"Promedio de pesos diarios"}},"fr":{"stringUnit":{"state":"translated","value":"Moyenne des poids quotidiens"}}}},
    "report.mode.latest": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses the latest measurement on each logged day. Missing days are not filled in."}},"es":{"stringUnit":{"state":"translated","value":"Usa la última medición de cada día registrado. Los días sin registros no se rellenan."}},"fr":{"stringUnit":{"state":"translated","value":"Utilise la dernière mesure de chaque jour enregistré. Les jours sans mesure ne sont pas complétés."}}}},
    "report.mode.average": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses the average measurement on each logged day. Missing days are not filled in."}},"es":{"stringUnit":{"state":"translated","value":"Usa el promedio de las mediciones de cada día registrado. Los días sin registros no se rellenan."}},"fr":{"stringUnit":{"state":"translated","value":"Utilise la moyenne des mesures de chaque jour enregistré. Les jours sans mesure ne sont pas complétés."}}}},
    "presentation.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dashboard & privacy"}},"es":{"stringUnit":{"state":"translated","value":"Panel y privacidad"}},"fr":{"stringUnit":{"state":"translated","value":"Tableau de bord et confidentialité"}}}},
    "presentation.hideWeights": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hide weight values"}},"es":{"stringUnit":{"state":"translated","value":"Ocultar valores de peso"}},"fr":{"stringUnit":{"state":"translated","value":"Masquer les valeurs de poids"}}}},
    "presentation.hideHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hide weight values in dashboard, history, charts and widgets on this device. Entry forms, goal settings and explicitly prepared exports still show weights. This is not an app lock."}},"es":{"stringUnit":{"state":"translated","value":"Oculta los pesos en el panel, historial, gráficos y widgets de este dispositivo. Los formularios, los ajustes de objetivos y las exportaciones preparadas expresamente siguen mostrando los pesos. No bloquea la app."}},"fr":{"stringUnit":{"state":"translated","value":"Masque les poids dans le tableau de bord, l’historique, les graphiques et les widgets de cet appareil. Les formulaires, les réglages d’objectif et les exports préparés explicitement affichent toujours les poids. Ce n’est pas un verrouillage de l’app."}}}},
    "presentation.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Privacy"}},"es":{"stringUnit":{"state":"translated","value":"Privacidad"}},"fr":{"stringUnit":{"state":"translated","value":"Confidentialité"}}}},
    "settings.deviceLocal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These preferences apply only to this device and do not sync with iCloud."}},"es":{"stringUnit":{"state":"translated","value":"Estas preferencias solo se aplican a este dispositivo y no se sincronizan con iCloud."}},"fr":{"stringUnit":{"state":"translated","value":"Ces préférences s’appliquent uniquement à cet appareil et ne sont pas synchronisées avec iCloud."}}}},
    "presentation.visible": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Visible dashboard cards"}},"es":{"stringUnit":{"state":"translated","value":"Tarjetas visibles del panel"}},"fr":{"stringUnit":{"state":"translated","value":"Cartes visibles du tableau de bord"}}}},
    "presentation.hidden": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hidden dashboard cards"}},"es":{"stringUnit":{"state":"translated","value":"Tarjetas ocultas del panel"}},"fr":{"stringUnit":{"state":"translated","value":"Cartes masquées du tableau de bord"}}}},
    "presentation.reorderHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the arrows or drag to reorder. Hiding a card never deletes your data."}},"es":{"stringUnit":{"state":"translated","value":"Usa las flechas o arrastra para cambiar el orden. Ocultar una tarjeta nunca elimina tus datos."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez les flèches ou faites glisser pour réorganiser. Masquer une carte ne supprime jamais vos données."}}}},
    "presentation.reset": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Restore all cards in default order"}},"es":{"stringUnit":{"state":"translated","value":"Restaurar todas las tarjetas en el orden predeterminado"}},"fr":{"stringUnit":{"state":"translated","value":"Rétablir toutes les cartes dans l’ordre par défaut"}}}},
    "reminders.next": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Next scheduled reminder"}},"es":{"stringUnit":{"state":"translated","value":"Próximo recordatorio programado"}},"fr":{"stringUnit":{"state":"translated","value":"Prochain rappel programmé"}}}},
    "reminders.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No upcoming reminder is scheduled."}},"es":{"stringUnit":{"state":"translated","value":"No hay ningún próximo recordatorio programado."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun rappel à venir n’est programmé."}}}},
    "reminders.openSettings": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open notification settings"}},"es":{"stringUnit":{"state":"translated","value":"Abrir ajustes de notificaciones"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir les réglages de notifications"}}}},
    "reminders.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A reminder could not be scheduled. Check notification permissions and try saving again."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo programar un recordatorio. Revisa los permisos de notificaciones e intenta guardar de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Un rappel n’a pas pu être programmé. Vérifiez les autorisations de notifications et réessayez d’enregistrer."}}}},
    "reminders.authorized": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications allowed"}},"es":{"stringUnit":{"state":"translated","value":"Notificaciones permitidas"}},"fr":{"stringUnit":{"state":"translated","value":"Notifications autorisées"}}}},
    "reminders.denied": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications denied in system settings"}},"es":{"stringUnit":{"state":"translated","value":"Notificaciones denegadas en los ajustes del sistema"}},"fr":{"stringUnit":{"state":"translated","value":"Notifications refusées dans les réglages système"}}}},
    "reminders.notRequested": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notification permission not requested"}},"es":{"stringUnit":{"state":"translated","value":"Permiso de notificaciones no solicitado"}},"fr":{"stringUnit":{"state":"translated","value":"Autorisation de notifications non demandée"}}}},
    "reminders.limited": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Limited notification permission"}},"es":{"stringUnit":{"state":"translated","value":"Permiso de notificaciones limitado"}},"fr":{"stringUnit":{"state":"translated","value":"Autorisation de notifications limitée"}}}},
    "reminders.unknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notification permission unavailable"}},"es":{"stringUnit":{"state":"translated","value":"Permiso de notificaciones no disponible"}},"fr":{"stringUnit":{"state":"translated","value":"Autorisation de notifications indisponible"}}}},
    "summary.entries": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Measurements: %lld"}},"es":{"stringUnit":{"state":"translated","value":"Mediciones: %lld"}},"fr":{"stringUnit":{"state":"translated","value":"Mesures : %lld"}}}},
    "import.readyCount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected for import: %lld"}},"es":{"stringUnit":{"state":"translated","value":"Seleccionadas para importar: %lld"}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionnées pour l’importation : %lld"}}}},
    "import.invalidCount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Invalid rows (not imported): %lld"}},"es":{"stringUnit":{"state":"translated","value":"Filas no válidas (no importadas): %lld"}},"fr":{"stringUnit":{"state":"translated","value":"Lignes non valides (non importées) : %lld"}}}},
    "import.importedCount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manual measurements added: %lld"}},"es":{"stringUnit":{"state":"translated","value":"Mediciones manuales añadidas: %lld"}},"fr":{"stringUnit":{"state":"translated","value":"Mesures manuelles ajoutées : %lld"}}}},
