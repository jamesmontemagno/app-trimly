    "deleteHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This deletes the entry from this app and its iCloud history, not Apple Health. Hide it instead to keep a reversible record."}},"es":{"stringUnit":{"state":"translated","value":"Esto elimina la entrada de esta app y su historial de iCloud, no de Apple Salud. Ocúltala para poder restaurarla."}},"fr":{"stringUnit":{"state":"translated","value":"La mesure sera supprimée de cette app et de son historique iCloud, pas d’Apple Santé. Masquez-la pour pouvoir la rétablir."}}}},
    "healthReadOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Health measurements are read-only here. Notes and visibility changes apply only to this app. Deleted imported measurements may be imported again."}},"es":{"stringUnit":{"state":"translated","value":"Las mediciones de Apple Salud son de solo lectura aquí. Las notas y la visibilidad solo cambian en esta app. Las mediciones importadas eliminadas podrían importarse de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Les mesures Apple Santé sont en lecture seule ici. Les notes et la visibilité ne changent que dans cette app. Les mesures importées supprimées peuvent être réimportées."}}}},
    "localEdits": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Changes apply to this app and iCloud. Previously written Apple Health measurements are not changed."}},"es":{"stringUnit":{"state":"translated","value":"Los cambios se aplican a esta app y a iCloud. Las mediciones escritas antes en Apple Salud no cambian."}},"fr":{"stringUnit":{"state":"translated","value":"Les modifications s’appliquent à cette app et à iCloud. Les mesures déjà enregistrées dans Apple Santé ne sont pas modifiées."}}}},
