    "csv.error.unclosed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A quoted field is not closed before the end of the file."}},"es":{"stringUnit":{"state":"translated","value":"Un campo entre comillas no se cierra antes del final del archivo."}},"fr":{"stringUnit":{"state":"translated","value":"Un champ entre guillemets n’est pas fermé avant la fin du fichier."}}}},
