    "import.date.month": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Month first (MM/DD/YYYY)"}},"es":{"stringUnit":{"state":"translated","value":"Mes primero (MM/DD/AAAA)"}},"fr":{"stringUnit":{"state":"translated","value":"Mois en premier (MM/JJ/AAAA)"}}}},
