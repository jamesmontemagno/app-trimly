    "report.loggedDays": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Days logged: %lld"}},"es":{"stringUnit":{"state":"translated","value":"Días registrados: %lld"}},"fr":{"stringUnit":{"state":"translated","value":"Jours enregistrés : %lld"}}}},
    "report.dates": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ – %@"}},"es":{"stringUnit":{"state":"translated","value":"%@ – %@"}},"fr":{"stringUnit":{"state":"translated","value":"%@ – %@"}}}},
