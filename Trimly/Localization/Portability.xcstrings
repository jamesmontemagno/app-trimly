    "csv.error.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The CSV file is empty."}},"es":{"stringUnit":{"state":"translated","value":"El archivo CSV está vacío."}},"fr":{"stringUnit":{"state":"translated","value":"Le fichier CSV est vide."}}}},
