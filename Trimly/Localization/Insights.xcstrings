    "dashboard.noCards": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"All dashboard cards are hidden. Customize the dashboard to show them again."}},"es":{"stringUnit":{"state":"translated","value":"Todas las tarjetas del panel están ocultas. Personaliza el panel para mostrarlas de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Toutes les cartes du tableau de bord sont masquées. Personnalisez-le pour les afficher à nouveau."}}}}
  }
