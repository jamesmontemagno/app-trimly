    "deadlineHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pace comparisons are descriptive estimates, not recommended rates of weight change."}},"es":{"stringUnit":{"state":"translated","value":"Las comparaciones de ritmo son estimaciones descriptivas, no recomendaciones de cambio de peso."}},"fr":{"stringUnit":{"state":"translated","value":"Les comparaisons de rythme sont des estimations descriptives, pas des recommandations de variation de poids."}}}},
