    "range.short.quarter": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"3M"}},"es":{"stringUnit":{"state":"translated","value":"3 m"}},"fr":{"stringUnit":{"state":"translated","value":"3 m"}}}},
    "range.short.year": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"1Y"}},"es":{"stringUnit":{"state":"translated","value":"1 a"}},"fr":{"stringUnit":{"state":"translated","value":"1 a"}}}},
    "range.more": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"More"}},"es":{"stringUnit":{"state":"translated","value":"Más"}},"fr":{"stringUnit":{"state":"translated","value":"Plus"}}}},
    "range.start": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Start date"}},"es":{"stringUnit":{"state":"translated","value":"Fecha de inicio"}},"fr":{"stringUnit":{"state":"translated","value":"Date de début"}}}},
    "range.end": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"End date"}},"es":{"stringUnit":{"state":"translated","value":"Fecha de fin"}},"fr":{"stringUnit":{"state":"translated","value":"Date de fin"}}}},
    "range.noGoal": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Set a goal to view its date range."}},"es":{"stringUnit":{"state":"translated","value":"Establece un objetivo para ver su intervalo de fechas."}},"fr":{"stringUnit":{"state":"translated","value":"Définissez un objectif pour afficher sa période."}}}},
    "range.invalid": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an end date on or after the start date."}},"es":{"stringUnit":{"state":"translated","value":"Elige una fecha de fin igual o posterior a la fecha de inicio."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez une date de fin égale ou postérieure à la date de début."}}}},
    "recap.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Period recap"}},"es":{"stringUnit":{"state":"translated","value":"Resumen del período"}},"fr":{"stringUnit":{"state":"translated","value":"Bilan de la période"}}}},
    "recap.weekly": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This week"}},"es":{"stringUnit":{"state":"translated","value":"Esta semana"}},"fr":{"stringUnit":{"state":"translated","value":"Cette semaine"}}}},
    "recap.monthly": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This month"}},"es":{"stringUnit":{"state":"translated","value":"Este mes"}},"fr":{"stringUnit":{"state":"translated","value":"Ce mois-ci"}}}},
    "recap.current": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Current period"}},"es":{"stringUnit":{"state":"translated","value":"Período actual"}},"fr":{"stringUnit":{"state":"translated","value":"Période actuelle"}}}},
    "recap.previous": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Previous period"}},"es":{"stringUnit":{"state":"translated","value":"Período anterior"}},"fr":{"stringUnit":{"state":"translated","value":"Période précédente"}}}},
    "recap.compare": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compare custom periods"}},"es":{"stringUnit":{"state":"translated","value":"Comparar períodos personalizados"}},"fr":{"stringUnit":{"state":"translated","value":"Comparer des périodes personnalisées"}}}},
    "recap.compareTitle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compare periods"}},"es":{"stringUnit":{"state":"translated","value":"Comparar períodos"}},"fr":{"stringUnit":{"state":"translated","value":"Comparer les périodes"}}}},
    "recap.explanation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Equal elapsed calendar-day windows are compared. A shorter previous month caps both windows. Each logged day has equal weight; missing days are not estimated."}},"es":{"stringUnit":{"state":"translated","value":"Se comparan intervalos con el mismo número de días naturales transcurridos. Si el mes anterior es más corto, se limitan ambos intervalos. Cada día registrado cuenta por igual; los días sin datos no se estiman."}},"fr":{"stringUnit":{"state":"translated","value":"Les périodes comparées comptent autant de jours calendaires écoulés. Un mois précédent plus court limite les deux périodes. Chaque jour enregistré compte autant ; les jours sans données ne sont pas estimés."}}}},
    "recap.customExplanation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compare daily averages and logging coverage. Periods can have different lengths; missing days are not estimated."}},"es":{"stringUnit":{"state":"translated","value":"Compara promedios diarios y días registrados. Los períodos pueden tener distintas duraciones; los días sin datos no se estiman."}},"fr":{"stringUnit":{"state":"translated","value":"Comparez les moyennes quotidiennes et les jours enregistrés. Les périodes peuvent avoir des durées différentes ; les jours sans données ne sont pas estimés."}}}},
    "recap.difference": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Average change from previous period"}},"es":{"stringUnit":{"state":"translated","value":"Cambio del promedio respecto al período anterior"}},"fr":{"stringUnit":{"state":"translated","value":"Écart de moyenne avec la période précédente"}}}},
    "recap.unavailable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Log in both periods to compare averages."}},"es":{"stringUnit":{"state":"translated","value":"Registra datos en ambos períodos para comparar promedios."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrez des données dans les deux périodes pour comparer les moyennes."}}}},
    "recap.noMeasurements": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No measurements in this period"}},"es":{"stringUnit":{"state":"translated","value":"No hay mediciones en este período"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune mesure sur cette période"}}}},
    "recap.coverage": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Logging days: %1$lld of %2$lld"}},"es":{"stringUnit":{"state":"translated","value":"Días registrados: %1$lld de %2$lld"}},"fr":{"stringUnit":{"state":"translated","value":"Jours enregistrés : %1$lld sur %2$lld"}}}},
    "analytics.loggingDays": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Logging days"}},"es":{"stringUnit":{"state":"translated","value":"Días registrados"}},"fr":{"stringUnit":{"state":"translated","value":"Jours enregistrés"}}}},
    "analytics.loggingDayAverage": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Average · last 7 logging days"}},"es":{"stringUnit":{"state":"translated","value":"Promedio · últimos 7 días registrados"}},"fr":{"stringUnit":{"state":"translated","value":"Moyenne · 7 derniers jours enregistrés"}}}},
    "analytics.samplesExplanation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"SMA and EMA use logging-day samples, not elapsed calendar days. Missing days are skipped. Earlier history warms the lines before the visible range."}},"es":{"stringUnit":{"state":"translated","value":"SMA y EMA usan muestras de días registrados, no días naturales transcurridos. Se omiten los días sin datos. El historial anterior se usa para iniciar las líneas antes del intervalo visible."}},"fr":{"stringUnit":{"state":"translated","value":"SMA et EMA utilisent les jours enregistrés, pas les jours calendaires écoulés. Les jours sans données sont ignorés. L’historique antérieur initialise les courbes avant la période visible."}}}},
    "analytics.samplePeriod": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Logging-day samples: %lld"}},"es":{"stringUnit":{"state":"translated","value":"Muestras de días registrados: %lld"}},"fr":{"stringUnit":{"state":"translated","value":"Échantillons de jours enregistrés : %lld"}}}},
    "support.insufficient": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"More logging history is needed for a reliable trend."}},"es":{"stringUnit":{"state":"translated","value":"Se necesita más historial de registros para obtener una tendencia fiable."}},"fr":{"stringUnit":{"state":"translated","value":"Davantage d’historique est nécessaire pour une tendance fiable."}}}},
    "support.sparse": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Measurements cover fewer than half the days. Trend estimates are unavailable."}},"es":{"stringUnit":{"state":"translated","value":"Hay mediciones en menos de la mitad de los días. No se pueden estimar tendencias."}},"fr":{"stringUnit":{"state":"translated","value":"Les mesures couvrent moins de la moitié des jours. Les estimations de tendance sont indisponibles."}}}},
    "support.stale": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No recent measurement. Log again to update the estimate."}},"es":{"stringUnit":{"state":"translated","value":"No hay mediciones recientes. Registra otra para actualizar la estimación."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune mesure récente. Ajoutez-en une pour actualiser l’estimation."}}}},
    "support.explanation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Trends require at least 7 logging days spanning a week, coverage of half the days, and a measurement within 7 days."}},"es":{"stringUnit":{"state":"translated","value":"Las tendencias requieren al menos 7 días registrados a lo largo de una semana, datos en la mitad de los días y una medición en los últimos 7 días."}},"fr":{"stringUnit":{"state":"translated","value":"Les tendances nécessitent au moins 7 jours enregistrés sur une semaine, des données sur la moitié des jours et une mesure datant de 7 jours au maximum."}}}},
    "support.counts": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Logging days: %1$lld; calendar days: %2$lld"}},"es":{"stringUnit":{"state":"translated","value":"Días registrados: %1$lld; días naturales: %2$lld"}},"fr":{"stringUnit":{"state":"translated","value":"Jours enregistrés : %1$lld ; jours calendaires : %2$lld"}}}},
    "plateau.message": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Little overall change across %lld calendar days."}},"es":{"stringUnit":{"state":"translated","value":"Poco cambio general a lo largo de %lld días naturales."}},"fr":{"stringUnit":{"state":"translated","value":"Peu de variation globale sur %lld jours calendaires."}}}},
    "plateau.explanation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent measurements show little overall change and low variation. This describes the data for either gain or loss goals, not a diagnosis or a reason to change your plan."}},"es":{"stringUnit":{"state":"translated","value":"Las mediciones recientes muestran poco cambio general y poca variación. Esto describe los datos tanto para objetivos de aumento como de pérdida; no es un diagnóstico ni un motivo para cambiar tu plan."}},"fr":{"stringUnit":{"state":"translated","value":"Les mesures récentes montrent peu de changement global et de faibles variations. Cela décrit les données pour les objectifs de prise comme de perte de poids, sans constituer un diagnostic ni une raison de modifier votre programme."}}}},
    "plateau.dismiss": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Dismiss plateau insight"}},"es":{"stringUnit":{"state":"translated","value":"Descartar información de estabilidad"}},"fr":{"stringUnit":{"state":"translated","value":"Masquer l’information de stabilité"}}}},
    "chart.dayDetails": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Entries and notes"}},"es":{"stringUnit":{"state":"translated","value":"Registros y notas"}},"fr":{"stringUnit":{"state":"translated","value":"Entrées et notes"}}}},
    "chart.dayDetailsHint": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens all entries and notes for this day"}},"es":{"stringUnit":{"state":"translated","value":"Abre todos los registros y notas de este día"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvre toutes les entrées et notes de ce jour"}}}},
    "chart.notes": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Has notes"}},"es":{"stringUnit":{"state":"translated","value":"Tiene notas"}},"fr":{"stringUnit":{"state":"translated","value":"Contient des notes"}}}},
    "chart.chooseDay": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a logging day"}},"es":{"stringUnit":{"state":"translated","value":"Elegir un día registrado"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir un jour enregistré"}}}},
    "chart.weightTrend": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Weight trend"}},"es":{"stringUnit":{"state":"translated","value":"Tendencia del peso"}},"fr":{"stringUnit":{"state":"translated","value":"Tendance du poids"}}}},
    "chart.date": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Date"}},"es":{"stringUnit":{"state":"translated","value":"Fecha"}},"fr":{"stringUnit":{"state":"translated","value":"Date"}}}},
    "chart.series": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Series"}},"es":{"stringUnit":{"state":"translated","value":"Serie"}},"fr":{"stringUnit":{"state":"translated","value":"Série"}}}},
    "pace.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Goal pace"}},"es":{"stringUnit":{"state":"translated","value":"Ritmo del objetivo"}},"fr":{"stringUnit":{"state":"translated","value":"Rythme de l’objectif"}}}},
    "pace.required": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Required average change"}},"es":{"stringUnit":{"state":"translated","value":"Cambio promedio necesario"}},"fr":{"stringUnit":{"state":"translated","value":"Variation moyenne nécessaire"}}}},
    "pace.observed": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Observed change · last 28 days"}},"es":{"stringUnit":{"state":"translated","value":"Cambio observado · últimos 28 días"}},"fr":{"stringUnit":{"state":"translated","value":"Variation observée · 28 derniers jours"}}}},
    "pace.explanation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Arithmetic based on your chosen target and date, not a recommended rate or medical advice. Trends can change."}},"es":{"stringUnit":{"state":"translated","value":"Cálculo basado en el objetivo y la fecha que elegiste, no en un ritmo recomendado ni en consejos médicos. Las tendencias pueden cambiar."}},"fr":{"stringUnit":{"state":"translated","value":"Calcul fondé sur l’objectif et la date que vous avez choisis, et non sur un rythme recommandé ou un avis médical. Les tendances peuvent évoluer."}}}},
    "pace.noGoal": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Set a goal to see its pace."}},"es":{"stringUnit":{"state":"translated","value":"Establece un objetivo para ver su ritmo."}},"fr":{"stringUnit":{"state":"translated","value":"Définissez un objectif pour afficher son rythme."}}}},
    "pace.missingDate": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Add a target date to your goal to compare pace."}},"es":{"stringUnit":{"state":"translated","value":"Añade una fecha límite al objetivo para comparar el ritmo."}},"fr":{"stringUnit":{"state":"translated","value":"Ajoutez une date cible à votre objectif pour comparer le rythme."}}}},
    "pace.missingData": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A valid measurement since the goal started is needed."}},"es":{"stringUnit":{"state":"translated","value":"Se necesita una medición válida desde el inicio del objetivo."}},"fr":{"stringUnit":{"state":"translated","value":"Une mesure valide depuis le début de l’objectif est nécessaire."}}}},
    "pace.achieved": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Goal already achieved"}},"es":{"stringUnit":{"state":"translated","value":"Objetivo ya alcanzado"}},"fr":{"stringUnit":{"state":"translated","value":"Objectif déjà atteint"}}}},
    "pace.expired": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Target date reached or passed. Choose a future date to compare pace."}},"es":{"stringUnit":{"state":"translated","value":"La fecha límite ha llegado o pasado. Elige una fecha futura para comparar el ritmo."}},"fr":{"stringUnit":{"state":"translated","value":"Date cible atteinte ou dépassée. Choisissez une date future pour comparer le rythme."}}}},
    "pace.onPace": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Observed trend meets the chosen pace"}},"es":{"stringUnit":{"state":"translated","value":"La tendencia observada cumple el ritmo elegido"}},"fr":{"stringUnit":{"state":"translated","value":"La tendance observée respecte le rythme choisi"}}}},
    "pace.behind": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Observed trend does not currently meet the chosen pace"}},"es":{"stringUnit":{"state":"translated","value":"La tendencia observada no cumple actualmente el ritmo elegido"}},"fr":{"stringUnit":{"state":"translated","value":"La tendance observée ne respecte pas actuellement le rythme choisi"}}}},
    "pace.weeklyRate": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ per week"}},"es":{"stringUnit":{"state":"translated","value":"%@ por semana"}},"fr":{"stringUnit":{"state":"translated","value":"%@ par semaine"}}}},
    "pace.remaining": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Calendar days remaining: %lld"}},"es":{"stringUnit":{"state":"translated","value":"Días naturales restantes: %lld"}},"fr":{"stringUnit":{"state":"translated","value":"Jours calendaires restants : %lld"}}}},
    "dashboard.customize": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Customize dashboard"}},"es":{"stringUnit":{"state":"translated","value":"Personalizar panel"}},"fr":{"stringUnit":{"state":"translated","value":"Personnaliser le tableau de bord"}}}},
    "dashboard.hideWeights": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hide dashboard weights"}},"es":{"stringUnit":{"state":"translated","value":"Ocultar pesos del panel"}},"fr":{"stringUnit":{"state":"translated","value":"Masquer les poids du tableau de bord"}}}},
    "dashboard.privacyTitle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Weights hidden"}},"es":{"stringUnit":{"state":"translated","value":"Pesos ocultos"}},"fr":{"stringUnit":{"state":"translated","value":"Poids masqués"}}}},
    "dashboard.privacyExplanation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Weight values and charts are hidden on this dashboard, including from VoiceOver. Other screens remain visible."}},"es":{"stringUnit":{"state":"translated","value":"Los valores de peso y los gráficos se ocultan en este panel, también para VoiceOver. Las demás pantallas siguen visibles."}},"fr":{"stringUnit":{"state":"translated","value":"Les poids et graphiques sont masqués sur ce tableau de bord, y compris pour VoiceOver. Les autres écrans restent visibles."}}}},
    "dashboard.visibleCards": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Visible cards"}},"es":{"stringUnit":{"state":"translated","value":"Tarjetas visibles"}},"fr":{"stringUnit":{"state":"translated","value":"Cartes visibles"}}}},
